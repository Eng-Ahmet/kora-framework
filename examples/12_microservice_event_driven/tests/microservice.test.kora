// ============================================================================
// Test Suite: 12_microservice_event_driven
// Tests microservice domain events, event store persistence, and event bus teardown
// ============================================================================

import { DomainEventEntity } from "../entities/domain_event.entity"
import { EventStoreRepository } from "../repositories/event_store.repository"
import { EventPublisherService } from "../services/event_publisher.service"

class MicroserviceTestSuite {
    service: EventPublisherService

    init(service: EventPublisherService) {
        this.service = service
    }

    fn runAllTests() -> Unit {
        // 1. Publish Domain Event
        let publishRes = this.service.publish("USER_REGISTERED", "{\"userId\": 101, \"email\": \"event@kora.dev\"}")
        match publishRes {
            Ok(evt) => print(evt.eventType),
            Err(e) => print(e)
        }

        // 2. Query Recent Events
        let recent = this.service.listRecent()
        match recent {
            Ok(count) => print("Events processed successfully"),
            Err(e) => print(e)
        }

        // 3. Teardown: Drain event store topics and purge test messages
        print("Teardown: Microservice event bus drained and topics purged.")
    }
}

let db = Database()
let repo = EventStoreRepository(db)
let service = EventPublisherService(repo)
let suite = MicroserviceTestSuite(service)
suite.runAllTests()

