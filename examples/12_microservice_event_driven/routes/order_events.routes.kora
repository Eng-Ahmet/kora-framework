import { OrderEventsController } from "../controllers/order_events.controller"
import { DomainEventEntity } from "../entities/domain_event.entity"

class OrderEventsRoutes {
    controller: OrderEventsController

    init(controller: OrderEventsController) {
        this.controller = controller
    }

    fn publishOrderPlaced() -> Result<DomainEventEntity, String> {
        return this.controller.publishOrderPlaced()
    }

    fn getEvents() -> Result<Int, String> {
        return this.controller.getEvents()
    }
}
