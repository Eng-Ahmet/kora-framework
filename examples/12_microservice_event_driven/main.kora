// ============================================================================
// Example 12: Microservices & Event-Driven Architecture — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { OrderEventsRoutes } from "./routes/order_events.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(OrderEventsRoutes)
        app.listen(8081)
    }
}

let app = Application()
app.bootstrap()
