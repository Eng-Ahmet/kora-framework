// ============================================================================
// Example 11: Operators, Control Flow & Resilience — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { PipelineRouter } from "./routes/pipeline.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(PipelineRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
