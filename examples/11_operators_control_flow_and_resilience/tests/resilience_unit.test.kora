// ============================================================================
// Unit Test Suite: 11_operators_control_flow_and_resilience
// Verifies backoff calculation, divide-by-zero resilience, and batch processing
// ============================================================================

import { PipelineJobRequest, PipelineJobSummary } from "../models/system_config.model"
import { ResilientPipelineService } from "../services/resilient_pipeline.service"

class ResilienceUnitTestSuite {
    pipeline: ResilientPipelineService

    init(pipeline: ResilientPipelineService) {
        this.pipeline = pipeline
    }

    fn test_backoff_calculation() -> Bool {
        let delay1 = this.pipeline.calculateBackoff(1)
        let delay2 = this.pipeline.calculateBackoff(2)
        return delay1 == 100 && delay2 == 200
    }

    fn test_execute_batch() -> Bool {
        let req = PipelineJobRequest {
            jobName: "unit_job",
            batchSize: 5,
            timeoutSeconds: Some(10),
            payloads: ["payload_1", "payload_2"],
            retryAttempts: Some(2)
        }
        let summary = this.pipeline.executeBatchJob(req)
        return summary.processedItems >= 0 && summary.isSuccessful
    }

    fn run() -> Unit {
        let p1 = this.test_backoff_calculation()
        let p2 = this.test_execute_batch()
        if p1 && p2 {
            print("  ✓ Resilience Unit Tests: 2/2 passed")
        } else {
            print("  ✗ Resilience Unit Tests: failed")
        }
    }
}

let pipeline = ResilientPipelineService()
let suite = ResilienceUnitTestSuite(pipeline)
suite.run()
