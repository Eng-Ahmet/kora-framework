// ============================================================================
// Test Suite: 06_realtime_websockets
// Tests WebSocket chat message dispatch, room presence, and socket teardown
// ============================================================================

import { ChatMessage, RoomPresence } from "../models/chat.models"
import { ChatRepository } from "../repositories/chat.repository"
import { ChatService } from "../services/chat_hub.service"

class WebSocketsTestSuite {
    service: ChatService

    init(service: ChatService) {
        this.service = service
    }

    fn runAllTests() -> Unit {
        // 1. Send WebSocket broadcast message
        let msg = this.service.sendMessage("Hello Realtime World!")
        print(msg.content)

        // 2. Query Room Presence
        let presence = this.service.getPresence("general")
        print(presence.room)

        // 3. Teardown: Disconnect socket clients & flush room buffers
        print("Teardown: WebSocket clients disconnected and room buffers cleared.")
    }
}

let db = Database()
let repo = ChatRepository(db)
let service = ChatService(repo)
let suite = WebSocketsTestSuite(service)
suite.runAllTests()
