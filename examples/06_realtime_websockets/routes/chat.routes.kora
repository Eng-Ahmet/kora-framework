// ============================================================================
// Realtime Chat — Modular Routes Definition Layer
// ============================================================================

import { ChatController } from "../controllers/chat.controller"

class ChatRoutes {
    controller: ChatController

    init(controller: ChatController) {
        this.controller = controller
    }

    fn presence(request: Request) -> Response {
        return this.controller.presence(request)
    }

    fn sendMessage(request: Request) -> Response {
        return this.controller.sendMessage(request)
    }
}
