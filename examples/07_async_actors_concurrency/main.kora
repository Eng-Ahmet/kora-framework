// ============================================================================
// Example 07: Async Actors & Channel Concurrency — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { ActorRouter } from "./routes/actor.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(ActorRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
