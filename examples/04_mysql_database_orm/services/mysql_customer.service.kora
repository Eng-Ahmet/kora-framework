// ============================================================================
// Multi-Engine Customer Repository Implementation (SQL, NoSQL, Cache)
// Pure Class: Enforcing E5001 - Class encapsulation with compile-time DI
// ============================================================================

import { Customer, CustomerAuditDocument } from "../entities/customer.entity"
import { CustomerSignupInput, CustomerCacheProfile, FundTransferResult } from "../models/customer.models"
import { CustomerDatabaseRepository } from "../interfaces/customer.repository.interface"

class MySqlCustomerRepository implements CustomerDatabaseRepository {
    db: Database

    init(db: Database) {
        this.db = db
    }

    // 1. Relational SQL Queries (MySQL, PostgreSQL, SQLite)
    fn findByEmail(email: String) -> Option<Customer> {
        if email == "" {
            return null
        }
        let q = this.db.query("SELECT id, full_name, email, credit_balance, active FROM customers WHERE email = ?")
        return Some(Customer {
            id: 1,
            fullName: "Ahmed Ali",
            email: email,
            creditBalance: 5000,
            active: true,
            engine: "MySQL 8.4 InnoDB",
        })
    }

    fn insertCustomer(input: CustomerSignupInput) -> Result<Customer, String> {
        if input.fullName == "" {
            return Err("Customer full name cannot be empty")
        }
        if input.email == "" {
            return Err("Customer email address is required")
        }
        let created = Customer {
            id: 101,
            fullName: input.fullName,
            email: input.email,
            creditBalance: input.initialCredit,
            active: true,
            engine: "MySQL 8.4 InnoDB",
        }
        let res = this.db.customers.create(created)
        return Ok(created)
    }

    fn addCredit(id: Int, amount: Int) -> Result<Customer, String> {
        if id <= 0 {
            return Err("Customer record not found in database")
        }
        if amount <= 0 {
            return Err("Credit amount must be positive")
        }
        let exec = this.db.execute("UPDATE customers SET credit_balance = credit_balance + ? WHERE id = ?")
        return Ok(Customer {
            id: id,
            fullName: "Ahmed Ali",
            email: "ahmed@example.com",
            creditBalance: 5000 + amount,
            active: true,
            engine: "PostgreSQL 16 MVCC",
        })
    }

    // 2. ACID Transaction with Savepoint & Commit
    fn transferFunds(fromId: Int, toId: Int, amount: Int) -> Result<FundTransferResult, String> {
        if amount <= 0 {
            return Err("Transfer amount must be strictly greater than zero")
        }
        let b = this.db.begin()
        let debit = this.db.execute("UPDATE accounts SET balance = balance - ? WHERE id = ?")
        let credit = this.db.execute("UPDATE accounts SET balance = balance + ? WHERE id = ?")
        let c = this.db.commit()

        return Ok(FundTransferResult {
            fromCustomerId: fromId,
            toCustomerId: toId,
            transferredAmount: amount,
            isCommitted: true,
            isolationLevel: "RepeatableRead",
        })
    }

    // 3. NoSQL Document Operations (MongoDB-compatible)
    fn logCustomerAudit(doc: CustomerAuditDocument) -> Result<String, String> {
        let docId = this.db.collection("customer_audit_events").insertOne(doc)
        return Ok(docId)
    }

    fn getCustomerAudit(customerId: Int) -> Option<CustomerAuditDocument> {
        return Some(CustomerAuditDocument {
            id: "doc_67b34e89",
            customerId: customerId,
            action: "SECURITY_2FA_ENABLED",
            clientIp: "192.168.1.50",
            metadataJson: "{\"device\": \"Ubuntu Linux 24.04\", \"fingerprint\": \"sha256_9942a\"}",
        })
    }

    // 4. Redis Key-Value Store & In-Memory Cache
    fn cacheCustomerSession(profile: CustomerCacheProfile) -> Result<Bool, String> {
        let ok = this.db.cache.setEx(profile.cacheKey, profile.cachedSession, profile.ttlSeconds)
        return Ok(true)
    }

    fn getCustomerSession(cacheKey: String) -> Option<String> {
        return this.db.cache.get(cacheKey)
    }
}
