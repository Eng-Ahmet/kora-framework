// ============================================================================
// Multi-Engine Customer Router (SQL, NoSQL, Redis Cache)
// Pure Class: Enforcing E5001 - Exposes decoupled route endpoints
// ============================================================================

import { Customer, CustomerAuditDocument } from "../entities/customer.entity"
import { CustomerSignupInput, CustomerCacheProfile, FundTransferResult } from "../models/customer.models"
import { MySqlCustomerRepository } from "../services/mysql_customer.service"

class CustomerRouter {
    repo: MySqlCustomerRepository

    init(repo: MySqlCustomerRepository) {
        this.repo = repo
    }

    // 1. Relational SQL Queries (MySQL, PostgreSQL, SQLite)
    fn lookup(email: String) -> Option<Customer> {
        return this.repo.findByEmail(email)
    }

    fn register(email: String) -> Result<Customer, String> {
        let input = CustomerSignupInput {
            fullName: "New Customer",
            email: email,
            initialCredit: 1000,
        }
        return this.repo.insertCustomer(input)
    }

    fn addCredit(id: Int, amount: Int) -> Result<Customer, String> {
        return this.repo.addCredit(id, amount)
    }

    // 2. ACID Transaction Transfer
    fn transfer(fromId: Int, toId: Int, amount: Int) -> Result<FundTransferResult, String> {
        return this.repo.transferFunds(fromId, toId, amount)
    }

    // 3. NoSQL Document Store
    fn audit(customerId: Int, action: String) -> Result<String, String> {
        let doc = CustomerAuditDocument {
            id: "",
            customerId: customerId,
            action: action,
            clientIp: "127.0.0.1",
            metadataJson: "{\"source\": \"kora_http_gateway\"}",
        }
        return this.repo.logCustomerAudit(doc)
    }

    fn getAudit(customerId: Int) -> Option<CustomerAuditDocument> {
        return this.repo.getCustomerAudit(customerId)
    }

    // 4. Redis Key-Value Cache
    fn saveSession(key: String, session: String) -> Result<Bool, String> {
        let profile = CustomerCacheProfile {
            cacheKey: key,
            cachedSession: session,
            ttlSeconds: 3600,
        }
        return this.repo.cacheCustomerSession(profile)
    }

    fn getSession(key: String) -> Option<String> {
        return this.repo.getCustomerSession(key)
    }
}
