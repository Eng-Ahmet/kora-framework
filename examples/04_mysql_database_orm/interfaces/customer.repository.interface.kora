// ============================================================================
// Multi-Engine Customer Database Repository Interface
// Pure Contract: Enforcing E5002 - Pure abstraction without concrete DB leaks
// ============================================================================

import { Customer } from "../entities/customer.entity"
import { CustomerSignupInput } from "../models/customer.models"

interface CustomerDatabaseRepository {
    fn findByEmail(email: String) -> Option<Customer>
    fn insertCustomer(input: CustomerSignupInput) -> Result<Customer, String>
    fn addCredit(id: Int, amount: Int) -> Result<Customer, String>
}
