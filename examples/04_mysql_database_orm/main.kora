// ============================================================================
// Example 04: MySQL Database ORM & Migrations — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { CustomerRouter } from "./routes/customer.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(CustomerRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
