// ============================================================================
// Multi-Engine DTOs & Transport Models (Non-Entity Data Transfer Objects)
// Placed in models/ - Transport Models
// ============================================================================

model CustomerSignupInput {
    fullName: String
    email: String
    initialCredit: Int
}

model CustomerCacheProfile {
    cacheKey: String
    cachedSession: String
    ttlSeconds: Int
}

model FundTransferResult {
    fromCustomerId: Int
    toCustomerId: Int
    transferredAmount: Int
    isCommitted: Bool
    isolationLevel: String
}
