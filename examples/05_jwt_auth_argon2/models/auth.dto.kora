// ============================================================================
// Authentication Data Transfer Objects & Domain Models
// ============================================================================

import { AuthUser } from "../entities/auth_user.entity"

model RegisterRequest {
    username: String
    plainPassword: String
}

model LoginRequest {
    username: String
    plainPassword: String
}

model AuthTokenResponse {
    token: String
    tokenType: String
    expiresInSeconds: Int
}

