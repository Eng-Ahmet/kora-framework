// Example 05: JWT Auth with Argon2 Password Hashing — Main Entrypoint
// ============================================================================
// Encapsulated within Application Class Container
// ============================================================================

import { AuthRouter } from "./routes/auth.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(AuthRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
