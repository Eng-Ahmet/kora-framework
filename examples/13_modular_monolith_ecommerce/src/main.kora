// ============================================================================
// Example 13: Modular Monolith E-Commerce — Main Entrypoint
// Pure Modular Clean Architecture: Independent feature modules with loose coupling
// Encapsulated within Application Class Container
// ============================================================================

import { CatalogRoutes } from "./modules/catalog/routes/catalog.routes"
import { BillingRoutes } from "./modules/billing/routes/billing.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(CatalogRoutes)
        app.use(BillingRoutes)
        app.listen(8082)
    }
}

let app = Application()
app.bootstrap()
