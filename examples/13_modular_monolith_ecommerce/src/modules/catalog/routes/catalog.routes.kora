import { CatalogController } from "../controllers/catalog.controller"
import { CatalogItemEntity } from "../entities/catalog_item.entity"

class CatalogRoutes {
    controller: CatalogController

    init(controller: CatalogController) {
        this.controller = controller
    }

    fn getCatalog() -> Result<Int, String> {
        return this.controller.getCatalog()
    }

    fn createProduct() -> Result<CatalogItemEntity, String> {
        return this.controller.createProduct()
    }
}
