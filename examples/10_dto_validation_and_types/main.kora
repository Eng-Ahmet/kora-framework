// ============================================================================
// Example 10: DTO Validation & Type System — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { ValidationRouter } from "./routes/validation.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(ValidationRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
