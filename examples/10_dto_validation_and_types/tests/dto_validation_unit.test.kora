// ============================================================================
// Unit Test Suite: 10_dto_validation_and_types
// Tests DTO field validation, checksum constraints, and nested geo coordinates
// ============================================================================

import { FileUploadDto, ImageMetadataDto } from "../models/file.dto"
import { AddressDto, GeoLocationDto } from "../models/nested.dto"
import { DtoValidatorService } from "../services/dto_validator.service"

class DtoValidationUnitTestSuite {
    validator: DtoValidatorService

    init(validator: DtoValidatorService) {
        this.validator = validator
    }

    fn test_valid_file_upload() -> Bool {
        let validFile = FileUploadDto {
            fileName: "doc.png",
            mimeType: "image/png",
            sizeBytes: 1024,
            sha256Checksum: "checksum_123",
            isPublic: true,
            imageMeta: None
        }
        let res = this.validator.validateFileUpload(validFile)
        return match res {
            Ok(ok) => ok,
            Err(e) => false,
        }
    }

    fn test_invalid_file_size() -> Bool {
        let invalidFile = FileUploadDto {
            fileName: "doc.png",
            mimeType: "image/png",
            sizeBytes: 0,
            sha256Checksum: "checksum_123",
            isPublic: true,
            imageMeta: None
        }
        let res = this.validator.validateFileUpload(invalidFile)
        return match res {
            Ok(ok) => false,
            Err(e) => true,
        }
    }

    fn run() -> Unit {
        let p1 = this.test_valid_file_upload()
        let p2 = this.test_invalid_file_size()
        if p1 && p2 {
            print("  ✓ DTO Validation Unit Tests: 2/2 passed")
        } else {
            print("  ✗ DTO Validation Unit Tests: failed")
        }
    }
}

let validator = DtoValidatorService()
let suite = DtoValidationUnitTestSuite(validator)
suite.run()
