// ============================================================================
// Test Suite: 10_dto_validation_and_types
// Tests DTO boundary validation, RFC errors, and payload teardown cleanup
// ============================================================================

import { FileUploadDto, ImageMetadataDto } from "../models/file.dto"
import { AddressDto, GeoLocationDto } from "../models/nested.dto"
import { DtoValidatorService } from "../services/dto_validator.service"

class DtoValidationTestSuite {
    validator: DtoValidatorService

    init(validator: DtoValidatorService) {
        this.validator = validator
    }

    fn runAllTests() -> Unit {
        // 1. Valid File Upload DTO
        let validFile = FileUploadDto {
            fileName: "profile.png",
            mimeType: "image/png",
            sizeBytes: 204850,
            sha256Checksum: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            isPublic: true,
            imageMeta: Some(ImageMetadataDto {
                width: 800,
                height: 600,
                aspectRatio: "4:3",
                hasAlphaChannel: true
            })
        }
        let fileResult = this.validator.validateFileUpload(validFile)
        match fileResult {
            Ok(valid) => print("File upload valid"),
            Err(e) => print(e)
        }

        // 2. Invalid File Upload DTO (Oversized)
        let oversizedFile = FileUploadDto {
            fileName: "video.mp4",
            mimeType: "video/mp4",
            sizeBytes: 99999999,
            sha256Checksum: "invalid_checksum",
            isPublic: false,
            imageMeta: None
        }
        let failResult = this.validator.validateFileUpload(oversizedFile)
        match failResult {
            Ok(v) => print("Should have failed"),
            Err(e) => print(e)
        }

        // 3. Valid Address DTO
        let address = AddressDto {
            street: "42 Cloud Avenue",
            city: "Zurich",
            postalCode: "8001",
            countryCode: "CH",
            geo: Some(GeoLocationDto {
                latitude: 47.3769,
                longitude: 8.5417,
                accuracyMeters: 5.0,
                timezone: "Europe/Zurich"
            })
        }
        let addressResult = this.validator.validateAddress(address)
        match addressResult {
            Ok(v) => print("Address valid"),
            Err(e) => print(e)
        }

        // 4. Teardown: Invalidate validation schema cache and release buffers
        print("Teardown: DTO validation cache purged and memory released.")
    }
}

let validator = DtoValidatorService()
let suite = DtoValidationTestSuite(validator)
suite.runAllTests()
