import { TelemetryController } from "../controllers/telemetry.controller"
import { IotMetricEntity } from "../models/iot_metric.entity"

class TelemetryRoutes {
    controller: TelemetryController

    init(controller: TelemetryController) {
        this.controller = controller
    }

    fn postMetric() -> Result<IotMetricEntity, String> {
        return this.controller.postMetric()
    }

    fn listMetrics() -> Result<Int, String> {
        return this.controller.listMetrics()
    }
}
