// ============================================================================
// Example 14: Realtime IoT Telemetry Ingestion — Main Entrypoint
// Pure Clean Architecture: Encapsulated within Application Class Container
// ============================================================================

import { TelemetryRoutes } from "./routes/telemetry.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(TelemetryRoutes)
        app.listen(8083)
    }
}

let app = Application()
app.bootstrap()
