// ============================================================================
// Example 02: Clean Architecture Users API — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { UserRouter } from "./routes/user.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(UserRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
