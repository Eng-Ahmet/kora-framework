// ============================================================================
// Example 03: CRUD Products API — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { ProductRouter } from "./routes/product.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(ProductRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
