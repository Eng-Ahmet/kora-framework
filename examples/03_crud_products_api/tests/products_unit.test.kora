// ============================================================================
// Unit Test Suite: 03_crud_products_api
// Verifies product creation validation, lookup invariants, and list queries
// ============================================================================

import { Product, CreateProductRequest, UpdateProductRequest } from "../models/product.models"
import { ProductRepository } from "../interfaces/product.repository.interface"
import { ProductService } from "../services/product.service"

class MockProductRepo implements ProductRepository {
    init() {}

    fn listAll() -> List<Product> {
        return [Product { id: 1, sku: "SKU-001", title: "Mechanical Keyboard", priceCents: 12000, inStock: true }]
    }

    fn findById(id: Int) -> Option<Product> {
        if id == 1 {
            return Some(Product { id: 1, sku: "SKU-001", title: "Mechanical Keyboard", priceCents: 12000, inStock: true })
        }
        return None
    }

    fn create(req: CreateProductRequest) -> Result<Product, String> {
        return Ok(Product { id: 10, sku: req.sku, title: req.title, priceCents: req.priceCents, inStock: true })
    }

    fn update(id: Int, req: UpdateProductRequest) -> Result<Product, String> {
        return Ok(Product { id: id, sku: "SKU-001", title: "Updated", priceCents: 12000, inStock: true })
    }

    fn delete(id: Int) -> Result<Bool, String> {
        return Ok(id > 0)
    }
}

class ProductsUnitTestSuite {
    service: ProductService

    init(service: ProductService) {
        this.service = service
    }

    fn test_list_all() -> Bool {
        let list = this.service.listAll()
        return list.len() > 0
    }

    fn test_find_by_id() -> Bool {
        let p = this.service.findById(1)
        return match p {
            Some(prod) => prod.inStock,
            None => false,
        }
    }

    fn run() -> Unit {
        let p1 = this.test_list_all()
        let p2 = this.test_find_by_id()
        if p1 && p2 {
            print("  ✓ Products CRUD Unit Tests: 2/2 passed")
        } else {
            print("  ✗ Products CRUD Unit Tests: failed")
        }
    }
}

let repo = MockProductRepo()
let service = ProductService(repo)
let suite = ProductsUnitTestSuite(service)
suite.run()
