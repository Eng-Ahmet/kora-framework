// ============================================================================
// User Domain Model & Registration Inputs
// Decorated with Schema Indexing, Uniqueness & DTO Constraints
// ============================================================================

import { User } from "entities/user.entity";

model UserRegisterInput {
    @required
    @email
    email: String

    @required
    fullName: String

    @min(0)
    initialBalance: Int
}

model UserProfileDto {
    id: Int
    email: String
    fullName: String
    role: String
}
