// ============================================================================
// Kora Modular Clean Architecture Enterprise Showcase — Main Entrypoint
// Pure Architectural Discipline: Imports models & enums from dedicated modules
// Everything is Class-Based Architecture with Compile-Time Dependency Injection
// ============================================================================

import { ApiRouter } from "./routes/api.routes"
import { DatabaseRouter } from "./routes/database.routes"
import { AuthRouter } from "./routes/auth.routes"
import { OrderRouter } from "./routes/order.routes"
import { CorsPolicy } from "./middleware/cors.middleware"
import { RateLimiterService } from "./middleware/rate_limit.middleware"
import { TelemetryTracker } from "./middleware/telemetry.middleware"
import { CompressionService } from "./middleware/compression.middleware"

// ============================================================================
// Enterprise Application Container (Class-based Lifecycle & Orchestration)
// ============================================================================

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()

        // 1. Enterprise Security, Throttling & Observability Middlewares
        app.use(CorsPolicy)
        app.use(RateLimiterService)
        app.use(TelemetryTracker)
        app.use(CompressionService)

        // 2. Domain & System Routers (Mount via app.use)
        app.use(ApiRouter)
        app.use(DatabaseRouter)
        app.use(AuthRouter)
        app.use(OrderRouter)

        // 3. Listen on Enterprise Gateway Port
        app.listen(8080)
    }
}

// ============================================================================
// Server Bootstrap & Execution
// ============================================================================

let app = Application()
app.bootstrap()
