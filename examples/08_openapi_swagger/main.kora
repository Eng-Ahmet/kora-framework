// ============================================================================
// Example 08: OpenAPI Swagger & Schema Generation — Main Entrypoint
// Encapsulated within Application Class Container
// ============================================================================

import { ArticleRouter } from "./routes/article.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let app = run()
        app.use(ArticleRouter)
        app.listen(3000)
    }
}

let app = Application()
app.bootstrap()
