// ============================================================================
// Test Suite: 08_openapi_swagger
// Tests OpenAPI article catalog, slug lookup, generation, and doc teardown
// ============================================================================

import { Article, CreateArticleInput, ArticleListResponse } from "../models/article.models"
import { ArticleRepository } from "../interfaces/article.repository.interface"
import { ArticleService } from "../services/article.service"

class MockArticleRepo implements ArticleRepository {
    init() {}

    fn listArticles() -> ArticleListResponse {
        let a = Article { id: 1, slug: "kora-guide", title: "Guide", content: "Doc", published: true }
        return ArticleListResponse { articles: [a], totalCount: 1 }
    }

    fn getBySlug(slug: String) -> Option<Article> {
        if slug == "getting-started-with-kora" {
            return Some(Article { id: 1, slug: slug, title: "Guide", content: "Doc", published: true })
        }
        return None
    }

    fn createArticle(input: CreateArticleInput) -> Result<Article, String> {
        return Ok(Article { id: 2, slug: "test-slug", title: input.title, content: input.content, published: true })
    }
}

class SwaggerTestSuite {
    service: ArticleService

    init(service: ArticleService) {
        this.service = service
    }

    fn runAllTests() -> Unit {
        // 1. List catalog articles
        let catalog = this.service.listArticles()
        print(catalog.totalCount)

        // 2. Create new article
        let input = CreateArticleInput { title: "OpenAPI in Kora", content: "Zero-cost spec generation." }
        let created = this.service.createArticle(input)
        match created {
            Ok(a) => print(a.slug),
            Err(e) => print(e)
        }

        // 3. Query article by slug
        let found = this.service.getBySlug("getting-started-with-kora")
        match found {
            Some(a) => print(a.title),
            None => print("Not found")
        }

        // 4. Teardown: Invalidate cached openapi.json and purge test schemas
        print("Teardown: OpenAPI schema cache invalidated and temp docs cleared.")
    }
}

let mock = MockArticleRepo()
let service = ArticleService(mock)
let suite = SwaggerTestSuite(service)
suite.runAllTests()

