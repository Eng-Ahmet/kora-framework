{
  "name": "kora-vscode",
  "displayName": "Kora Language Support",
  "description": "Official syntax highlighting, rich language configuration, snippets, and real-time compiler diagnostics for the Kora programming language and framework.",
  "version": "0.8.0",
  "publisher": "kora-framework",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Eng. Ahmet Asaad Hammoud",
    "email": "eng.ahmet@uma.es",
    "url": "https://github.com/Eng-Ahmet"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hwai-technology/kora-framework.git",
    "directory": "integrations/vscode"
  },
  "homepage": "https://kora-lang.dev",
  "bugs": {
    "url": "https://github.com/Hwai-technology/kora-framework/issues"
  },
  "scripts": {
    "package": "vsce package --no-git-tag-version --baseImagesUrl https://raw.githubusercontent.com/Hwai-technology/kora-framework/main/integrations/vscode/",
    "publish:vscode": "vsce publish --baseImagesUrl https://raw.githubusercontent.com/Hwai-technology/kora-framework/main/integrations/vscode/",
    "publish:ovsx": "ovsx publish --baseImagesUrl https://raw.githubusercontent.com/Hwai-technology/kora-framework/main/integrations/vscode/",
    "publish:all": "npm run publish:vscode && npm run publish:ovsx"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "./icon.png",
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:kora",
    "workspaceContains:**/*.kora",
    "workspaceContains:**/*.kr",
    "onStartupFinished",
    "onView:kora.assistantView",
    "onCommand:kora.runFile",
    "onCommand:kora.checkFile",
    "onCommand:kora.formatFile",
    "onCommand:kora.smartRun",
    "onCommand:kora.runTests",
    "onCommand:kora.explainCode",
    "onCommand:kora.generateTests",
    "onCommand:kora.openExamplesExplorer",
    "onCommand:kora.fixDiagnostic",
    "onCommand:kora.auditFile",
    "onCommand:kora.analyzeWorkspace",
    "onCommand:kora.walkthroughSelection",
    "onCommand:kora.generateDocs",
    "onCommand:kora.validateProject",
    "onCommand:kora.openLearningCenter",
    "onCommand:kora.openArchitectureExplorer"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Themes"
  ],
  "keywords": [
    "kora",
    "kora-lang",
    "rust",
    "backend",
    "syntax",
    "framework",
    "clean-architecture",
    "concurrency",
    "actor",
    "type-system",
    "compiler"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kora",
        "aliases": [
          "Kora",
          "kora"
        ],
        "extensions": [
          ".kora",
          ".kr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kora-file.svg",
          "dark": "./icons/kora-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kora",
        "scopeName": "source.kora",
        "path": "./syntaxes/kora.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kora",
        "path": "./snippets/kora.snippets.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kora-sidebar",
          "title": "Kora Framework",
          "icon": "./icons/kora-file.svg"
        }
      ]
    },
    "views": {
      "kora-sidebar": [
        {
          "type": "webview",
          "id": "kora.assistantView",
          "name": "Kora AI Copilot & Architecture Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "kora.smartRun",
        "title": "Kora: Smart Run (Entrypoint / Test Suite)",
        "category": "Kora",
        "icon": "$(play)"
      },
      {
        "command": "kora.runFile",
        "title": "Kora: Run File",
        "category": "Kora",
        "icon": "$(play)"
      },
      {
        "command": "kora.checkFile",
        "title": "Kora: Check File",
        "category": "Kora",
        "icon": "$(check)"
      },
      {
        "command": "kora.runTests",
        "title": "Kora: Run Test Suite (kora test)",
        "category": "Kora",
        "icon": "$(beaker)"
      },
      {
        "command": "kora.formatFile",
        "title": "Kora: Format Document",
        "category": "Kora"
      },
      {
        "command": "kora.explainCode",
        "title": "Kora AI: Explain Current Code & Architecture",
        "category": "Kora",
        "icon": "$(sparkle)"
      },
      {
        "command": "kora.generateTests",
        "title": "Kora AI: Scaffold Unit & Load Tests",
        "category": "Kora",
        "icon": "$(beaker)"
      },
      {
        "command": "kora.openExamplesExplorer",
        "title": "Kora: Browse & Clone GitHub Examples",
        "category": "Kora",
        "icon": "$(cloud-download)"
      },
      {
        "command": "kora.fixDiagnostic",
        "title": "Kora AI: Auto-Fix Compiler Diagnostic",
        "category": "Kora"
      },
      {
        "command": "kora.auditFile",
        "title": "Kora AI: Audit File Against .agent Rules",
        "category": "Kora",
        "icon": "$(shield)"
      },
      {
        "command": "kora.analyzeWorkspace",
        "title": "Kora: Analyze Workspace & Architecture",
        "category": "Kora",
        "icon": "$(search)"
      },
      {
        "command": "kora.walkthroughSelection",
        "title": "Kora AI: Interactive Code Walkthrough",
        "category": "Kora",
        "icon": "$(book)"
      },
      {
        "command": "kora.generateDocs",
        "title": "Kora AI: Generate Documentation",
        "category": "Kora",
        "icon": "$(file-text)"
      },
      {
        "command": "kora.validateProject",
        "title": "Kora: Validate Project (Compiler & Rules)",
        "category": "Kora",
        "icon": "$(pass)"
      },
      {
        "command": "kora.openLearningCenter",
        "title": "Kora: Open Interactive Learning Center",
        "category": "Kora",
        "icon": "$(mortar-board)"
      },
      {
        "command": "kora.openArchitectureExplorer",
        "title": "Kora: Open Visual Architecture Explorer",
        "category": "Kora",
        "icon": "$(organization)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kora.smartRun",
          "when": "editorLangId == kora",
          "group": "1_kora@1"
        },
        {
          "command": "kora.explainCode",
          "when": "editorLangId == kora",
          "group": "1_kora@2"
        },
        {
          "command": "kora.auditFile",
          "when": "editorLangId == kora",
          "group": "1_kora@3"
        },
        {
          "command": "kora.generateTests",
          "when": "editorLangId == kora",
          "group": "1_kora@4"
        },
        {
          "command": "kora.checkFile",
          "when": "editorLangId == kora",
          "group": "1_kora@5"
        },
        {
          "command": "kora.formatFile",
          "when": "editorLangId == kora",
          "group": "1_kora@6"
        }
      ],
      "editor/title": [
        {
          "command": "kora.smartRun",
          "when": "editorLangId == kora",
          "group": "navigation@1"
        },
        {
          "command": "kora.explainCode",
          "when": "editorLangId == kora",
          "group": "navigation@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "kora.smartRun",
          "when": "editorLangId == kora",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Kora Language Support",
      "properties": {
        "kora.compilerPath": {
          "type": "string",
          "default": "kora",
          "description": "Path to the Kora compiler CLI binary (defaults to 'kora' in PATH)."
        },
        "kora.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time compiler diagnostics, type-checking, and architectural linting."
        },
        "kora.debounceMs": {
          "type": "number",
          "default": 350,
          "description": "Debounce delay (in milliseconds) before triggering real-time diagnostics on document change."
        },
        "kora.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run canonical code formatting on save for .kora and .kr files."
        },
        "kora.copilot.provider": {
          "type": "string",
          "enum": [
            "embedded",
            "ollama",
            "openai",
            "gemini",
            "anthropic",
            "custom"
          ],
          "default": "embedded",
          "description": "AI provider used by Kora Copilot (defaults to the built-in offline knowledge engine indexing .agent/rules and docs)."
        },
        "kora.copilot.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Custom LLM API endpoint URL (e.g. http://localhost:11434 for Ollama)."
        },
        "kora.copilot.model": {
          "type": "string",
          "default": "llama3",
          "description": "Model name for external LLM provider."
        },
        "kora.copilot.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for cloud LLM providers (OpenAI, Gemini, Anthropic)."
        }
      }
    },
    "iconThemes": [
      {
        "id": "kora-icons",
        "label": "Kora File Icons",
        "path": "./kora-icons.json"
      }
    ]
  }
}
