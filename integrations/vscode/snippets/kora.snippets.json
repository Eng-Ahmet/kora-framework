{
  "Data Transfer Model": {
    "prefix": "model",
    "body": [
      "model ${1:Name} {",
      "    ${2:field}: ${3:String}",
      "}"
    ],
    "description": "Create an immutable, pure Data Transfer Object (DTO) model"
  },
  "Database Entity Model": {
    "prefix": "entity",
    "body": [
      "@entity",
      "@table(\"${1:users}\")",
      "model ${2:User} {",
      "    @primary",
      "    @autoIncrement",
      "    id: Int",
      "    @required",
      "    ${3:name}: String",
      "}"
    ],
    "description": "Create a database entity model with ORM decorators"
  },
  "Service Class with DI": {
    "prefix": "class",
    "body": [
      "class ${1:Name}Service implements ${2:Interface} {",
      "    db: Database",
      "",
      "    init(db: Database) {",
      "        this.db = db",
      "    }",
      "",
      "    fn ${3:method}() -> ${4:Unit} {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Create a service class with compile-time Dependency Injection"
  },
  "Interface Declaration": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "    fn ${2:find}(id: Int) -> Option<${3:Model}>",
      "}"
    ],
    "description": "Create a behavioral contract interface"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Status} {",
      "    ${2:Active},",
      "    ${3:Inactive},",
      "    ${4:Pending}",
      "}"
    ],
    "description": "Create a type-safe enumerated type"
  },
  "Actor Concurrency": {
    "prefix": "actor",
    "body": [
      "class ${1:Counter}Actor {",
      "    var state: Int",
      "",
      "    init() {",
      "        this.state = 0",
      "    }",
      "",
      "    fn handle(msg: ${2:String}) -> Int {",
      "        this.state = this.state + 1",
      "        return this.state",
      "    }",
      "}"
    ],
    "description": "Create an isolated stateful Actor"
  },
  "Async Channel": {
    "prefix": "channel",
    "body": [
      "let ch = channel<${1:String}>(${2:100})",
      "ch.send(${3:value})",
      "let item = ch.recv()"
    ],
    "description": "Create and operate a non-blocking MPSC channel"
  },
  "Spawn Concurrent Task": {
    "prefix": "spawn",
    "body": [
      "spawn(async () => {",
      "    ${0}",
      "})"
    ],
    "description": "Spawn an asynchronous concurrent task"
  },
  "HTTP GET Route": {
    "prefix": "get",
    "body": [
      "get(\"${1:/path}\", (${2:svc: Service}) => {",
      "    return ${0}",
      "})"
    ],
    "description": "Create a zero-config HTTP GET endpoint"
  },
  "HTTP POST Route": {
    "prefix": "post",
    "body": [
      "post(\"${1:/path}\", (request: Request, ${2:svc: Service}) => {",
      "    return ${0}",
      "})"
    ],
    "description": "Create a zero-config HTTP POST endpoint"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    Some(${2:val}) => ${3:val},",
      "    None => ${4:fallback},",
      "}"
    ],
    "description": "Pattern matching expression"
  },
  "Try Catch Block": {
    "prefix": "try",
    "body": [
      "try {",
      "    ${1:// resilient operation}",
      "} catch (${2:err}) {",
      "    ${0:// handle error}",
      "}"
    ],
    "description": "Resilient structured try-catch error block"
  },
  "For In Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "    ${0}",
      "}"
    ],
    "description": "Iterate over collections, arrays, or numeric ranges"
  },
  "Compile-time Constant": {
    "prefix": "const",
    "body": [
      "const ${1:MAX_CONNECTIONS} = ${2:100}"
    ],
    "description": "Declare a compile-time immutable constant"
  },
  "Automated Unit Test Suite": {
    "prefix": "unit-test",
    "body": [
      "// ============================================================================",
      "// Unit Test Suite: ${1:Feature}UnitTestSuite",
      "// ============================================================================",
      "",
      "import { ${2:Service} } from \"../services/${3:service}\"",
      "",
      "class ${1:Feature}UnitTestSuite {",
      "    service: ${2:Service}",
      "",
      "    init(service: ${2:Service}) {",
      "        this.service = service",
      "    }",
      "",
      "    fn test_${4:operation}_success() -> Bool {",
      "        // 1. Arrange & Act",
      "        let res = this.service.${5:execute}()",
      "        // 2. Assert",
      "        return res != null",
      "    }",
      "",
      "    fn run() -> Unit {",
      "        let p1 = this.test_${4:operation}_success()",
      "        if p1 {",
      "            print(\"  [Pass] ${1:Feature} Unit Tests: passed\")",
      "        } else {",
      "            print(\"  [Fail] ${1:Feature} Unit Tests: failed\")",
      "        }",
      "    }",
      "}",
      "",
      "let suite = ${1:Feature}UnitTestSuite(${2:Service}())",
      "suite.run()"
    ],
    "description": "Scaffold an automated class-based Unit Test Suite"
  },
  "Peak Throughput Load Test Suite": {
    "prefix": "load-test",
    "body": [
      "// ============================================================================",
      "// Load Test Suite: ${1:Feature}LoadTestSuite",
      "// High-throughput concurrency stress testing with explicit state teardown",
      "// ============================================================================",
      "",
      "import { ${2:Service} } from \"../services/${3:service}\"",
      "",
      "class ${1:Feature}LoadTestSuite {",
      "    service: ${2:Service}",
      "",
      "    init(service: ${2:Service}) {",
      "        this.service = service",
      "    }",
      "",
      "    fn run_load_stress(iterations: Int) -> Int {",
      "        var processed = 0",
      "        for i in 0..iterations {",
      "            let ok = this.service.${4:execute}()",
      "            if ok {",
      "                processed += 1",
      "            }",
      "        }",
      "        return processed",
      "    }",
      "",
      "    fn teardown() -> Unit {",
      "        print(\"  [Pass] ${1:Feature} Teardown: synthetic load test allocations purged\")",
      "    }",
      "}",
      "",
      "let load_suite = ${1:Feature}LoadTestSuite(${2:Service}())",
      "let total = load_suite.run_load_stress(1000)",
      "print(\"  [Pass] ${1:Feature} Load Test: 1,000 iterations processed\")",
      "load_suite.teardown()"
    ],
    "description": "Scaffold a peak-throughput Load Test Suite with guaranteed resource teardown"
  },
  "Clean Architecture Controller": {
    "prefix": "controller",
    "body": [
      "import { ${1:Feature}Service } from \"../services/${2:feature}.service\"",
      "import { Create${1:Feature}Dto, ${1:Feature}ResponseDto } from \"../models/${2:feature}.dto\"",
      "",
      "class ${1:Feature}Controller {",
      "    service: ${1:Feature}Service",
      "",
      "    init(service: ${1:Feature}Service) {",
      "        this.service = service",
      "    }",
      "",
      "    fn list() -> List<${1:Feature}ResponseDto> {",
      "        return this.service.getAll()",
      "    }",
      "",
      "    fn getById(id: Int) -> Option<${1:Feature}ResponseDto> {",
      "        return this.service.findById(id)",
      "    }",
      "",
      "    fn create(dto: Create${1:Feature}Dto) -> Result<${1:Feature}ResponseDto, String> {",
      "        return this.service.create(dto)",
      "    }",
      "}"
    ],
    "description": "Clean Architecture HTTP Controller with Dependency Injection"
  },
  "WebSocket Realtime Hub": {
    "prefix": "websocket-hub",
    "body": [
      "class ${1:Chat}Hub {",
      "    room: String",
      "",
      "    init(room: String) {",
      "        this.room = room",
      "    }",
      "",
      "    fn broadcast(msg: String) -> Bool {",
      "        print(\"[WS:\" + this.room + \"] \" + msg)",
      "        return true",
      "    }",
      "}"
    ],
    "description": "Realtime WebSocket Hub construct"
  },
  "Redis Cache Service": {
    "prefix": "cache-service",
    "body": [
      "class ${1:App}CacheService {",
      "    db: Database",
      "",
      "    init(db: Database) {",
      "        this.db = db",
      "    }",
      "",
      "    fn setWithTtl(key: String, val: String, ttlSec: Int) -> Bool {",
      "        return true",
      "    }",
      "",
      "    fn get(key: String) -> Option<String> {",
      "        return Some(\"cached_val\")",
      "    }",
      "}"
    ],
    "description": "In-memory / Redis Key-Value cache service with TTL"
  }
}
